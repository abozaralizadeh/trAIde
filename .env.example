AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Optional: Azure APIM fronting Azure OpenAI (use subscription key)
AZURE_APIM_OPENAI_SUBSCRIPTION_KEY=
AZURE_APIM_OPENAI_API_VERSION=2024-08-01-preview
AZURE_APIM_OPENAI_ENDPOINT=https://your-apim-name.azure-api.net/
AZURE_APIM_OPENAI_DEPLOYMENT=your-deployment-name

KUCOIN_API_KEY=your-kucoin-api-key
KUCOIN_API_SECRET=your-kucoin-secret
KUCOIN_API_PASSPHRASE=your-kucoin-passphrase
KUCOIN_BASE_URL=https://api.kucoin.com
# KuCoin Futures base URL (default futures endpoint)
KUCOIN_FUTURES_BASE_URL=https://api-futures.kucoin.com

# Optional KuCoin Futures (uses the same KUCOIN_API_* credentials)
KUCOIN_FUTURES_ENABLED=true

# Comma-separated list of symbols to monitor/trade (e.g., BTC-USDT,ETH-USDT)
COINS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,DOGE-USDT
# Allow the agent to curate the coin list dynamically (true/false)
FLEXIBLE_COINS_ENABLED=true
# After this many consecutive agent runs with no trade (stuck/declining), force a handoff to
# the Research Agent to overhaul the coin list and surface fresh opportunities. 0 disables.
RESEARCH_HANDOFF_AFTER_NO_TRADE_RUNS=3
# Min minutes between forced Research handoffs (rate-limits the costly web-research sweep). 0=off.
RESEARCH_HANDOFF_COOLDOWN_MIN=30

# --- Risk guardrails (added after the RE-USDT concentration blowup) ---
# Block LONGs on non-major alts while BTC's daily regime is bearish (alts are high-beta to BTC).
ALT_LONG_BLOCK_WHEN_BTC_BEARISH=true
# Symbols exempt from the alt-long gate (they have their own daily gate).
ALT_MAJORS=BTC,ETH
# Signal-based exception: an alt that is bullish on 1D/4H/1H/15M at high confidence can trade at
# reduced size even while BTC is bearish. Leadership rotates; no coin is hardcoded.
RELATIVE_STRENGTH_LONGS_ENABLED=true
RELATIVE_STRENGTH_MIN_CONFIDENCE=0.82
RELATIVE_STRENGTH_SIZE_FACTOR=0.5
# Cap a single position's notional at this fraction of total equity, regardless of leverage. 0=off.
MAX_POSITION_EQUITY_PCT=0.5
# Block entries on futures contracts younger than this many days (freshly-listed = thin/volatile). 0=off.
MIN_FUTURES_LISTING_AGE_DAYS=7
# Minimum reward:risk for a futures entry: reject when the TP distance < this × the SL distance.
# Fixes the big-loss/small-win asymmetry (stops were being set wider than targets). 0=off.
MIN_FUTURES_RR=1.5
# Attach TP/SL to the futures ENTRY order (KuCoin st-orders bracket) so a limit fill is protected the
# instant it fills — not on the next agent run (positions were repeatedly found unprotected in that gap).
ATOMIC_BRACKET_ENABLED=true
# Safety net: if an open futures position is found with NO stop after a short grace, attach an emergency
# SL this far from entry (fraction) + a TP at MIN_FUTURES_RR× that, within one poll. The agent refines it. 0=off.
EMERGENCY_SL_PCT=0.02
# Market screener liquidity floor: scan_futures_market only surfaces perps with at least this much
# 24h USDT turnover (keeps discovery to liquid coins; rejects thin micro-caps). Lower = wider net.
SCREENER_MIN_TURNOVER_USD_24H=5000000

# --- Adaptive edge controller (src/edge.py) — self-tuning risk from rolling realized results ---
# Losing directions/symbols trade smaller and repeatedly-losing symbols are benched. The structural
# post-cost RR floor does not get stretched after losses. Risk relaxes automatically when expectancy
# recovers, so no manual regime re-tuning is required.
ADAPTIVE_EDGE_ENABLED=true
EDGE_LOOKBACK_TRADES=30        # rolling window of realized closes for the stats
EDGE_MIN_TRADES=8              # minimum closes before adaptive actions kick in
# Legacy compatibility settings used only by the old/offline adaptive-RR helpers.
EDGE_RR_STEP=0.5
EDGE_RR_CAP=2.5
EDGE_RR_STALE_HOURS=18
EDGE_SYMBOL_RR_MIN_TRADES=2
EDGE_BENCH_LOOKBACK=5          # per-symbol recent closes examined for the bench
EDGE_BENCH_MIN_LOSSES=3        # losses within that window (with negative net) that bench a symbol
EDGE_BENCH_COOLDOWN_HOURS=12   # base bench rest; scaled by loss count so a persistent loser sits out longer
EDGE_BENCH_COOLDOWN_MAX_MULT=4 # cap on that scaling (e.g. 12h × 4 = up to 48h for a chronically-losing symbol)
EDGE_STREAK_THRESHOLD=2        # consecutive realized losses that trigger the size throttle
EDGE_STREAK_SIZE_FACTOR=0.5    # entry-size multiplier while on a losing streak
EDGE_DIRECTION_MIN_TRADES=5    # evidence required before long/short-specific risk adapts
EDGE_NEGATIVE_EXPECTANCY_SIZE_FACTOR=0.5  # risk factor for a losing direction/symbol; never enlarges
# Futures margin mode: cross | isolated | auto. The cross-leverage call is only issued in cross mode.
KUCOIN_FUTURES_MARGIN_MODE=cross
# Fraction of agent runs traced to LangSmith (head sampling; avoids the monthly unique-trace cap).
LANGSMITH_SAMPLE_RATE=0.1

# --- Conviction sizing (added after SOL drawdown: full-size low-conviction shorts) ---
# Scale position size by how far confidence clears the floor: low-conviction entries size down,
# ramping to full size as conviction rises. Targets the agent's own "mixed/low-conviction" reads.
CONVICTION_SIZING_ENABLED=true
CONVICTION_FULL_CONFIDENCE=0.85   # confidence at/above which full size is used
CONVICTION_MIN_SIZE_FACTOR=0.5    # size multiplier at the confidence floor (linear ramp up to 1.0)

# --- Sizing coherence (Jul 2026 profitability fix) ---
# The soft size multipliers (regime, conviction, relative-strength, loss-streak, expectancy) used to
# COMPOUND: five independent 0.5-0.6 "be a bit cautious" reads multiplied a 1-2% risk budget down to
# ~0.03-0.05% — every position became fee-dust that couldn't clear costs even on a win. They are now
# combined by their single WORST signal (a min) and floored here, so a real edge is still sized to
# matter. Hard dollar-risk caps (ATR, risk budget, concentration, heat) still shrink independently.
SIZE_QUALITY_FLOOR=0.5            # never shrink the *combined soft* factor below this (1.0 disables soft shrink)
MIN_ENTRY_NOTIONAL_USD=0          # fee-aware floor: bump a sub-floor sized entry up to this (0=off, pure risk-budget)

# --- Deadlock break (added after the daily-vs-1h both-blocked stall recurred) ---
# In a clean (non-exhausted) daily trend, allow the daily-aligned entry (short in a bearish daily,
# long in a bullish daily) past the 1h gate when a 1h counter-bounce is stalling (15m no longer
# confirms it) and confidence clears a raised bar — so the bot isn't stranded flat in both directions.
DEADLOCK_BREAK_ENABLED=true
DEADLOCK_MIN_CONFIDENCE=0.72       # raised confidence bar to take the trend-continuation entry

# Safety controls
PAPER_TRADING=true
MAX_POSITION_USD=500
RISK_PER_TRADE_PCT=0.02   # CEILING on stop-defined equity risk. The EFFECTIVE fraction is derived below
# --- Risk-targeted sizing (Jul 29 2026 profitability fix) ---
# Position size used to be whatever notional the model named, merely CAPPED at the budget above --
# and capping is not sizing. Realized dollar risk across 35 recorded lifecycles ranged over 18.9x
# ($0.06 to $1.17 on a ~$68 account) with no relation to conviction or outcome; the winners were
# systematically the small bets and the losers the large ones, so the last 9 trades came in at
# +0.50R but -$0.12. A positive edge only turns into money if every trade bets the same fraction of
# it. Size is now computed FROM the risk budget and the stop distance. Conviction still moves size,
# but through the regime/confidence/expectancy multipliers rather than an arbitrary number.
RISK_TARGETED_SIZING=true
# The EFFECTIVE risk fraction is derived, not taken literally from RISK_PER_TRADE_PCT:
#     min(RISK_PER_TRADE_PCT, CB_MAX_DAILY_DRAWDOWN_PCT/100 / (CB_MAX_CONSECUTIVE_LOSSES + 1))
# Per-trade risk and the daily drawdown stop are not independent settings: at 2%/trade against a 3%
# daily stop, TWO losers end the day on an account taking 5-9 trades a day. That inconsistency went
# unnoticed for months only because realized risk was never actually 2% (it averaged 0.52%). With the
# defaults below the effective fraction is 3%/(3+1) = 0.75%, which survives three full stop-outs
# inside the daily budget. Raise CB_MAX_DAILY_DRAWDOWN_PCT if you want a larger per-trade bet --
# the two move together by construction, so there is no incoherent combination to maintain.
MIN_CONFIDENCE=0.65
SENTIMENT_FILTER_ENABLED=false
SENTIMENT_MIN_SCORE=0.55
MAX_LEVERAGE=3
MAX_TRADES_PER_SYMBOL_PER_DAY=6   # cap per-symbol churn (more trades = more fee drag + loss streaks)
MIN_NET_PROFIT_USD=0.5
MIN_PROFIT_ROI_PCT=0.008
ESTIMATED_SLIPPAGE_PCT=0.001     # PRIOR only — superseded by measured fills once SLIPPAGE_AUTOTUNE has a sample
# --- Slippage self-calibration (Jul 2026 profitability fix) ---
# Every RR gate, net-profit check and fee-adjusted breakeven prices friction as
# (fee_rate + ESTIMATED_SLIPPAGE_PCT) PER SIDE, so a stale constant silently becomes the strategy.
# The live config assumed 0.10%/side while measured entry slippage was 0.008% mean / 0.025% p90 — a
# ~12x overstatement. Round-tripped that is 0.32% of notional vs a real ~0.08%, and at the account's
# median risk/notional (1.3%) it charged every setup a phantom 0.18R. To still clear a 1.5 net-RR
# floor the model had to plan ~2.7R GROSS targets that the tape never reached (median favourable
# excursion in the sample: 0.27R). Overstating costs doesn't make a bot conservative — it makes it
# plan trades that cannot win. The estimate now comes from the bot's own fills (conservative upper
# percentile, clamped to [0.01%, 3x prior]) and adapts in BOTH directions if execution degrades.
SLIPPAGE_AUTOTUNE_ENABLED=true
SLIPPAGE_AUTOTUNE_MIN_SAMPLES=8  # fills required before the measurement displaces the prior above
# Enable regime-aware range trading (mean-reversion in sideways markets)
RANGE_TRADING_ENABLED=true

# Advanced trading features
# Disabled by default because the 60%/40% staging scheme compresses admitted reward:risk.
PARTIAL_TP_ENABLED=false
KELLY_SIZING_ENABLED=true
KELLY_MIN_TRADES=30
PREFER_LIMIT_ORDERS=true
LIMIT_ORDER_TIMEOUT_SEC=20
POST_LOSS_COOLDOWN_MINUTES=30
MAX_ENTRY_LEVERAGE=3              # keep <=5x (conservative); higher only for tight-stop scalps
MIN_TRADE_INTERVAL_MINUTES=10    # min spacing between entries on a symbol (anti-overtrading)
ENTRY_LIMIT_EXPIRY_MINUTES=15    # bot-tagged futures GTC entries are cancelled in code after this TTL (recycle unfilled passive limits faster)
MIN_ENTRY_DEVIATION_PCT=0.0005   # low-conviction resting limit must be >= this from price (marketable band handles high conviction)
MAX_24H_VOLATILITY_PCT=30
MAX_ATR_PCT_FOR_ENTRY=9          # soft-scale above this; hard-block above 1.5x. Raised so high-momentum leaders (~7% daily ATR) stay tradable

# --- Marketable entries (fill-rate fix) ---
# Passive-only limits resting away from price filled ~21% of the time: in a trend the price never
# comes back, so the bot missed the winners and only filled when the move failed (adverse selection).
# A HIGH-CONVICTION entry may now cross the spread up to the band below to fill immediately; the
# atomic TP/SL bracket still attaches, so the fill is never naked. Lower-conviction entries stay passive.
# Jul 30 2026, measured on real 1m paths over the 82 expired limits: only 3 of 80 plans fitted the old
# 0.15% band while the median cross needed is 0.82% -- the band blocked nearly every fill it existed to
# enable. And confidence is a weak filter for crossings (+0.050R mean at conf>=0.80) versus the
# RR-after-cross test (+0.388R). So the band is now only an OUTER SANITY BOUND and the binding test is
# the post-cost RR gate evaluated at the crossed price: pay up for a fill exactly as long as the trade
# still clears its structural floor from the price you actually pay.
# NOTE: do NOT try to raise fill rate by lengthening ENTRY_LIMIT_EXPIRY_MINUTES instead. The same replay
# shows later fills LOSE (-0.79R mean at 30min, -0.30R at 60min, -0.37R at 240min) -- a limit that fills
# late only fills because price came to it, i.e. the move went against the thesis. Waiting longer buys
# more adverse selection; crossing on a bracket that still has edge is what actually adds throughput.
MARKETABLE_ENTRY_MAX_DEV_PCT=0.01      # outer bound on how far an entry may cross to fill (0=off, passive-only)
MARKETABLE_ENTRY_MIN_CONFIDENCE=0      # 0 = no extra conviction bar; the post-cost RR gate decides

# --- Noise floor on stop distance (Jul 2026 — the single biggest measured loss driver) ---
# Across the 27 closed futures lifecycles of 20-27 Jul the median stop sat at 1.4x the 15m ATR
# (~0.7x the 1h ATR — LESS THAN ONE HOURLY BAR of ordinary movement). Median favourable excursion
# was +0.27R against targets planned at 2.3-2.7R gross, and NOT ONE trade reached its take-profit;
# trades with tighter-than-median stops averaged -0.40R vs -0.08R for wider ones. A stop inside the
# noise band isn't an invalidation level, it's a coin-flip on microstructure. Replaying those same
# entries on real 1m paths with this floor turned -4.5R into +4.9R, and every floor from 1.5x to 5x
# ATR is positive — the geometry matters, not the constant, so 2.5 is picked as ~one full 1h bar of
# noise (median ATR(1h)/ATR(15m) = 2.18) rather than as the replay's best value.
# This is a SURVIVAL guard, not an opportunity gate: it never vetoes a setup and never changes which
# symbol or direction is traded, it only widens the risk leg — and since size is stop-defined, the
# position shrinks to hold DOLLAR RISK PER TRADE CONSTANT. 0 disables.
STOP_ATR_FLOOR_MULT=2.5
# The floor also self-tunes from realized MAE: if the bot's own WINNERS routinely survive >=0.6R of
# adverse heat, the stop is inside the working range and the floor widens by 0.5 (capped at 4.0).
# Adaptation is WIDEN-ONLY by design — winners showing little heat is ambiguous (it can mean the stop
# already killed everything that breathed, which is exactly what this account's data looked like), and
# a too-tight stop destroys the strategy while a generous one only costs some size.
STOP_ATR_FLOOR_ADAPTIVE=true
STOP_ATR_FLOOR_MAX_WIDEN=4.0     # never rewrite a stop by more than this factor (past it, it's a different trade)
# When the floor widens the risk leg, scale the TARGET by the same factor so the bracket keeps its
# planned R-multiple. Measured live 2026-08-02, first 12.5h on the new code: widening only the stop
# dropped the median gross RR of rejected setups from 1.79 to 1.23 -- exactly cancelling the
# cost-model fix (which correctly cut friction drag 0.62 -> 0.28) -- so NET RR BLOCKs stayed flat at
# 0.19/run and the order rate fell 72%. The floor was being converted into RR rejections instead of
# into smaller size. Preserving the R-multiple makes it RR-neutral: ~43% of those rejections clear
# again, and replay says it costs nothing in exit quality (+4.12R scaled vs +4.09R unscaled; outcomes
# are flat across 0.8-2.0R of target distance). Set false to widen the stop only.
STOP_FLOOR_SCALES_TARGET=true
# Entry timing is the AGENT's judgement, not a hardcoded gate: the analysis surfaces an `entryMap`
# (extension-in-ATR from the 15m VWAP + pullback/retest anchors) and the prompt has an OPTIMAL ENTRY
# PLANNING step, so the model targets the highest-EV arrival price (rest a limit at the anticipated
# pullback after a spike rather than chasing the peak) and gets better as the model does. No knob.

# Circuit breakers (auto-restrict trading when risk thresholds exceeded)
CB_MAX_DAILY_DRAWDOWN_PCT=3.0    # 3R daily loss limit at the default 1% lifecycle risk
CB_MAX_CONSECUTIVE_LOSSES=3
CB_MAX_PORTFOLIO_HEAT_PCT=6.0    # total open risk if all stops hit at once ("6% rule")
CB_COOLDOWN_MINUTES=120

# Profit protection (code-driven, enforced outside the LLM — see src/protection.py)
# P1: ratchet the stop to breakeven once a trade reaches +N×risk, and close it if it
#     gives back too much of its peak run. P2: don't re-enter the same direction at a
#     worse price right after taking profit (the chase that caused the ETH round-trip).
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_DRY_RUN=false            # true = log intended actions without placing orders (observe first)
PROFIT_LOCK_BREAKEVEN_TRIGGER_R=1.0  # move stop to breakeven at this multiple of initial risk (>=1R is the consensus floor)
PROFIT_LOCK_BREAKEVEN_FEE_PCT=0.0015 # round-trip cost buffer (KuCoin futures taker 0.06%x2 + slippage) so breakeven nets >=0
PROFIT_LOCK_GIVEBACK_PCT=0.35        # close after retracing this fraction of the peak run; 0.35 retains ~65% of MFE (0 disables)
PROFIT_LOCK_MIN_FE_PCT=0.005         # min run (fraction of entry) before give-back can act — filters noise
PROFIT_LOCK_GIVEBACK_ARM_R=1.0       # ALSO require the run to reach this multiple of the trade's own risk (stop
                                     # distance) before give-back can act — stops booking fee-scale scratch wins
                                     # while losses ride to the full stop. 0 = pct-arming only (legacy)
# Early invalidation: cut a trade that NEVER went meaningfully green and is failing toward its stop,
# instead of riding to the full SL. MFE/MAE data shows winners work immediately while losers go against
# from the start — so this shrinks losers without touching winners (avg loss has been > avg win).
EARLY_CUT_ENABLED=true
EARLY_CUT_GRACE_MIN=20               # give a fresh entry this long to work before it can be cut
EARLY_CUT_MIN_FAVORABLE_PCT=0.003    # if peak excursion never reached this (fraction of entry), it "never worked"
EARLY_CUT_MAE_FRAC=0.85              # ...and it's this far toward the stop → cut. Set to 0.85 (was 0.6) per MAE
                                     # research: the cut must sit OUTSIDE the adverse-excursion band of your
                                     # WINNERS (which breathe ~0.57R here) or it stops you out when you're right.
                                     # At 0.85 it only front-runs a near-certain stop; trend setups keep room to base.
# Trend-adaptive exits (Jul 2026 profitability fix): a fixed 1R breakeven + 35% give-back is a
# mean-reversion harness — it shook the bot out of the high-ATR TRENDS it correctly picked (ZEC ran
# +354%/mo yet netted a loss across 8 lifecycles). A trade whose peak run reaches trend_runner_r × its
# OWN risk is a revealed trend winner (no external regime feed needed); for it the give-back cap arms
# later and tolerates a deeper pullback so the winner can run. Chop keeps the tight defaults above.
PROFIT_LOCK_TREND_ADAPTIVE=true
PROFIT_LOCK_TREND_RUNNER_R=2.0       # peak run (in R) at which a trade is treated as a trend winner
PROFIT_LOCK_TREND_GIVEBACK_PCT=0.55  # once a runner, tolerate giving back this much of peak (vs GIVEBACK_PCT in chop)
PROFIT_LOCK_TREND_GIVEBACK_ARM_R=2.5 # ...and only arm the loosened give-back after this much favorable run
# Trailing ratchet (default ON) — replaces the give-back MARKET-CLOSE. Jul 23 2026 give-back fix: the
# trail used to arm only at +1R and trail a full 1R behind the peak, but the account's real trades peak
# on a 0.3–1.7R scale (16 of 19 recent closes peaked BELOW +1R), so the trail never armed and green
# trades round-tripped to a FULL stop-out (ERA +0.85R→−0.05, RE +1.72R→+0.78).
# JUL 27 2026 CORRECTION — that Jul 23 tuning (arm 0.5R, lock 50% of peak) was measured and it made
# things WORSE. Arming at 0.5R engaged the ratchet on NOISE-scale excursions (the sample's median
# favourable excursion is 0.27R) and then booked half of it: the average win collapsed to +0.35R
# while the average loss stayed at -1.05R. No win rate survives a 0.33 payoff ratio — the live result
# LIVE was 27 trades, 37% win rate, avg win +0.38R vs avg loss -0.60R, net -6.4R. Replaying those
# same entries on real 1m paths under the planned bracket isolates the exit rule: 63% win rate but
# avg win +0.35R vs avg loss -1.05R — a 0.33 payoff ratio, net -4.5R. Trail-arm sweep, same paths:
#   arm 0.40R -0.17R | 0.50R +0.39R | 0.75R -0.24R | 1.00R +2.72R | 1.25R +2.25R | 1.50R +1.97R
# The principle: a trailing stop must not arm until the trade has earned back its OWN risk. Below +1R
# a "profit" is inside the noise the stop was drawn around, so locking it converts a live thesis into
# a coin-flip. Arm at 1R, trail a full 1R behind the peak, lock only a third of the run so a winner
# keeps room to become a runner. Floored at fee-breakeven, never backwards. Resting stop → rides
# wobbles to TP. Pure R (no ATR/%/per-symbol tuning), so it self-normalizes across symbols.
PROFIT_LOCK_TRAIL_ENABLED=true
PROFIT_LOCK_TRAIL_ARM_R=1.0          # arm only once the trade has made back its own risk (was 0.5 = noise)
PROFIT_LOCK_TRAIL_LOCK_FRAC=0.33     # lock at least this fraction of the peak favourable run once armed
PROFIT_LOCK_TRAIL_DISTANCE_R=1.0     # ...or trail this many R below the peak, whichever locks MORE
NO_CHASE_ENABLED=true
POST_WIN_COOLDOWN_MINUTES=45         # window after a winning close during which re-entry at a worse price is blocked
NO_CHASE_BUFFER_PCT=0.001            # tolerance band around the prior exit price

# Regime-aware entries (code-enforced — see src/regime.py)
# B: in a hostile (bearish / RSI-exhausted) daily, raise the confidence bar and shrink size so the
#    bot trades less and more selectively instead of churning bounce-scalps in a downtrend.
# D: permit trend-aligned shorts (shorting a confirmed downtrend) past the anti-FOMO gate, instead
#    of only ever longing oversold bounces — but only with 1h+15m confirmation and higher conviction.
REGIME_THROTTLE_ENABLED=true
REGIME_CAUTION_MIN_CONFIDENCE=0.75   # elevated confidence floor when the daily is bearish/exhausted
REGIME_CAUTION_SIZE_FACTOR=0.6       # position-size multiplier in a hostile regime
TREND_ALIGNED_SHORTS_ENABLED=true
TREND_SHORT_MIN_CONFIDENCE=0.78      # higher confidence bar specifically for a counter-bounce short
TREND_SHORT_REQUIRE_15M=true

# --- Fade-extreme playbook (Aug 2026) ---
# The bot could only ever express ONE playbook: trend continuation. Its regime label read "trending"
# on 68 of 69 recorded entries so the mean-reversion hints never fired; the daily gate blocks
# counter-daily entries; and the 1h gate blocks anything the 1h opposes -- which a fade has against it
# BY DEFINITION. Measured on the live universe (50d, 12 symbols, 4h hold, net of a 0.10% round trip),
# continuation returned -0.017% gross over 3,408 samples: flat, and flat does not cover costs.
# This does NOT assert that fading works -- on the same test it was positive in both halves but only
# t~1.0-1.6 over 135 independent events, i.e. suggestive, not established. It lets the setup REACH the
# model so signal_edge_stats can score it per family and risk can follow whatever actually pays.
# RSI bands are the textbook 30/70, deliberately NOT fitted to this sample.
FADE_EXTREME_ENABLED=true
FADE_EXTREME_OVERSOLD_RSI=30       # buy-side fades only permitted at/below this 15m RSI
FADE_EXTREME_OVERBOUGHT_RSI=70     # sell-side fades only permitted at/above this 15m RSI         # require 15m (not just 1h) bearish confirmation for the short
# Reversal long: allow a LONG past a bearish daily gate when 1h+15m have both turned bullish and
# confidence is high. The daily trend lags at bottoms, so without this the bot cannot catch a
# reversal (it sat out an +11% ETH bounce in the Jul 2-5 2026 chop). Majors only (alt longs stay
# blocked by the correlation gate). The reward:risk floor still applies to whatever passes.
REVERSAL_LONGS_ENABLED=true
REVERSAL_LONG_MIN_CONFIDENCE=0.80    # high bar — counter-daily longs are only for confirmed turns
REVERSAL_LONG_REQUIRE_15M=true       # require 15m (not just 1h) bullish confirmation
# Mirror: allow a SHORT past a bullish daily gate when 1h+15m confirm a roll-over. Regimes flip both
# ways — when the market turned bullish (Jul 2026) the bot was short-blocked in every pullback.
REVERSAL_SHORTS_ENABLED=true
REVERSAL_SHORT_MIN_CONFIDENCE=0.80
REVERSAL_SHORT_REQUIRE_15M=true

# Langsmith tracing (optional, no LangChain required)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trAIde
LANGSMITH_API_URL=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# Looping/scheduling
POLL_INTERVAL_SEC=60
PRICE_CHANGE_TRIGGER_PCT=0.5
MAX_IDLE_POLLS=10
# Protection still runs every poll. FLAT is the quiet-market HUNT cadence, kept at ~10min so the bot
# keeps hunting (frequent discovery prioritized over token cost). Repeated no-action runs back off by
# powers of two only when the multiplier is >1 (default 1=off). ACTIVE applies only to actual open
# positions. Atomic pending brackets use deterministic expiry and price triggers, not model babysitting.
FLAT_AGENT_COOLDOWN_SEC=600
ACTIVE_AGENT_COOLDOWN_SEC=300
FLAT_BACKOFF_MAX_MULTIPLIER=1.0
AGENT_MAX_TURNS=20
# Adaptive price-trigger tuning. A symbol's trigger threshold = its poll-noise EWMA × the noise
# multiplier, capped at PRICE_CHANGE_TRIGGER_PCT × the ceiling multiplier. The ceiling bounds
# worst-case blindness: at 2.0 any move >= 2× the base trigger always earns a fresh model look even
# in the noisiest symbol (safety-biased). Raise the ceiling to save more tokens; lower is safer.
PRICE_NOISE_MULTIPLIER=4.0
PRICE_TRIGGER_MAX_MULTIPLIER=2.0

# Agent memory
MEMORY_FILE=.agent_memory.json
RETENTION_DAYS=90

# Telegram notifications (create a bot via @BotFather, get chat_id via getUpdates)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT=false

# Supervisor Agent (interactive Telegram bot — responds to your messages)
SUPERVISOR_ENABLED=false
LOG_FILE=traide.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Public spectator dashboard publishing (Azure Blob + Table)
# Persists a SANITIZED, public-safe view of agent decisions/performance to Azure so a
# read-only website (SandBox repo) can visualize it. Never publishes balances, equity,
# position sizes, account IDs, or API keys. Reuses the `connection_string` below.
DASHBOARD_PUBLISH_ENABLED=false
# Azure Storage connection string (account-level). Same var name the SandBox consumer reads.
connection_string=
# Azure Table name (durable, queryable history) and Blob container (rolled-up JSON snapshots).
TRAIDE_TABLE_NAME=traidedashboard
TRAIDE_BLOB_NAME=traide-dashboard
# Minimum seconds between publishes (the trading loop calls the publisher every poll; it self-throttles).
DASHBOARD_PUBLISH_INTERVAL_SEC=300
# Money disclosure: normalized (% returns + indexed curve only, no $) | absolute ($ realized PnL, no balances) | both
DASHBOARD_DISCLOSURE=normalized
# How many recent decisions to include in the live feed.
DASHBOARD_FEED_LIMIT=30
# Starting value of the normalized equity index (curve begins here).
DASHBOARD_INDEX_BASE=100

# Tracing (Azure Monitor via OTLP/HTTP)
ENABLE_TRACING=false
# Enable verbose console span export (dev only)
ENABLE_CONSOLE_TRACING=false
# If you want to export spans to OpenAI traces endpoint (per tutorial)
OPENAI_TRACE_API_KEY=
# Example for Azure Monitor data collection endpoint (DCE):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-dce>.<region>.ingest.monitor.azure.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <dce-token-or-apim-key>
